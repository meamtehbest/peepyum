[sub_resource type="GDScript" id="GDScript_vao7y"]
script/source = "extends Node2D
var rain: PackedScene = load(\"res://itsraining.tscn\")
var sc = 0
var last = 0
func _ready():
	last = Global.score
func _on_timer_timeout():
	var fallingpeep = rain.instantiate()
	$peepfall.add_child(fallingpeep)
	
func _process(_delta):
	if Global.score != last:
		print(Global.score)
		last = Global.score
"

