[sub_resource type="GDScript" id="GDScript_d2e78"]
script/source = "extends Label
var last = 0
func _ready():
	last = Global.score
func _process(_delta):
	if Global.score != last:
		text = str(Global.score)
		last = Global.score
	if Global.score < 0:
		$\"../lose_\".visible = true
	if Global.score > 20:
		$\"../win!\".visible = true
"

